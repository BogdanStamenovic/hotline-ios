# Rendered by hotline-ios ownbox.sh -- edit systemd/hotline-ios.service.in, not this file.
[Unit]
Description=hotline-ios daemon (the phone app's server: roster, channels, control)
Documentation=file://@DIR@/docs/SERVER-PLAN.md
After=network-online.target
Wants=network-online.target
# Never give up restarting; see the note by Restart= below.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@DIR@/server
# hotline_ios imports hotline's registry; src/ is the package itself.
Environment=PYTHONPATH=src:@HOTLINE_SRC@
@ENVIRONMENT@
# Secrets are NOT here on purpose: daemon.py calls load_env() on the checkout's
# .env at startup, so HOTLINE_API_KEY reaches os.environ without ever being
# written into a unit file. Phone calls are hotline-calld's (hotline-call); this
# daemon forwards to it on 127.0.0.1:8792 and needs no cvoiced and no GPU.
ExecStart=@DIR@/server/.venv/bin/python -m hotline_ios.daemon --host @HOST@ --port @PORT@
# The bind address is the tailscale IP, which does not exist until tailscaled
# has come up, so at boot that races. Losing it does not raise -- loopback still
# binds -- so daemon.py checks the sockets and exits on purpose, and this is
# what turns that exit into a retry. Do not "clean this up" into
# Restart=on-failure with a start limit: a slow tailscale would then mean no
# app until someone notices by hand.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
