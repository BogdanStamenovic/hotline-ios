# Copy to .env (mode 600, gitignored) and fill in. Nothing here is a secret that
# leaves the machine; the Telegram values are account credentials for the
# account that RINGS him, not for his own.

# From https://my.telegram.org -- the calling account's application.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Where the signed-in session is written by `tg-login`.
TELEGRAM_SESSION=/home/bodas/.config/hotline-ios/telegram
# Who to ring: a @username, a phone number, or a numeric user id. HIS account,
# not the calling one -- an account cannot call itself.
TELEGRAM_PEER=

# Same gate as hotlined: a source-IP allowlist on top of a Tailscale-only bind.
# Loopback is always allowed regardless, so a blocked agent on this box is never
# locked out of the phone by the allowlist that exists to keep others out.
HOTLINE_ALLOW_IPS=100.108.255.28
# Optional second factor, sent as X-Hotline-Key.
HOTLINE_API_KEY=
